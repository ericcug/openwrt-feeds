#!/bin/sh /etc/rc.common

START=95
STOP=10

USE_PROCD=1
PROG=/usr/bin/mimic

start_instance() {
	local cfg="$1"

	local enabled
	config_get_bool enabled "$cfg" 'enabled' 0
	[ "$enabled" -eq 1 ] || return 0

	local interface
	config_get interface "$cfg" 'interface'
	[ -n "$interface" ] || return 1

	procd_open_instance "$cfg"
	procd_set_param command "$PROG" run

	local link_type xdp_mode use_libxdp max_window quiet verbose padding
	config_get link_type "$cfg" 'link_type'
	config_get xdp_mode "$cfg" 'xdp_mode'
	config_get_bool use_libxdp "$cfg" 'use_libxdp' 0
	config_get_bool max_window "$cfg" 'max_window' 0
	config_get_bool quiet "$cfg" 'quiet' 0
	config_get_bool verbose "$cfg" 'verbose' 0
	config_get padding "$cfg" 'padding'

	[ -n "$link_type" ] && procd_append_param command -L "$link_type"
	[ -n "$xdp_mode" ] && procd_append_param command -x "$xdp_mode"
	
	# kfunc mode: kernel module is mandatory for checksum fixup
	if [ ! -d /sys/module/mimic ]; then
		modprobe mimic 2>/dev/null || {
			logger -t mimic "Error: Failed to load mimic kernel module (required for kfunc checksum hack)"
			return 1
		}
	fi

	[ "$use_libxdp" -eq 1 ] && procd_append_param command -X
	[ "$max_window" -eq 1 ] && procd_append_param command -W
	[ "$quiet" -eq 1 ] && procd_append_param command -q
	[ "$verbose" -eq 1 ] && procd_append_param command -v
	[ -n "$padding" ] && procd_append_param command -p "$padding"

	append_filter() {
		procd_append_param command -f "$1"
	}
	config_list_foreach "$cfg" 'filter' append_filter

	procd_append_param command "$interface"

	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1

	procd_close_instance
}

start_service() {
	config_load 'mimic'
	config_foreach start_instance 'mimic'
	config_foreach start_instance 'instance'
}

service_triggers() {
	procd_add_reload_trigger 'mimic'
}
